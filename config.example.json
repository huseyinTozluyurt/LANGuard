{
  "interface": null,
  "gateway": null,
  "log_file": "/var/log/languard.log",
  "json_log": null,
  "notify": true,
  "alert_cooldown": 60,
  "modules": ["arp", "devices", "dhcp", "dns", "scan", "ipv6", "mitm",
              "path", "tls", "strip", "filewatch", "host", "localdns"],

  "arp": {"flood_window": 10, "flood_threshold": 30,
          "multi_ip_threshold": 3, "multi_ip_window": 300, "verify": true},
  "devices": {"alert_unknown": true, "scan_interval": 300,
              "mac_flood_window": 60, "mac_flood_threshold": 50,
              "frame_watch": true, "frame_flood_window": 10, "frame_flood_threshold": 500},
  "dhcp": {"trusted_servers": [], "starvation_window": 60, "starvation_threshold": 30},
  "dns": {"window": 5, "plain_ok": [], "alert_private_answers": true,
          "internal_suffixes": [".local", ".lan", ".home", ".arpa", ".internal",
                                ".localdomain", ".home.arpa"]},
  "scan": {"window": 10, "port_threshold": 15, "conn_threshold": 20,
           "watch_ports": [21, 22, 23, 25, 445, 3306, 3389, 5900],
           "block": false, "never_block": []},
  "ipv6": {"trusted_routers": [], "trusted_dhcp6": []},
  "mitm": {"honeypot_interval": 300},
  "path": {"interval": 60, "probe_target": "1.1.1.1"},
  "tls": {"interval": 300,
          "sites": ["www.google.com", "github.com", "www.wikipedia.org", "www.cloudflare.com"],
          "check_http_redirect": true, "probe_learned": 6, "captive_portal_check": true},
  "strip": {"sites": [], "upgrade_window": 6, "hsts_preload": true},
  "localdns": {"interval": 120, "probe_interval": 300, "probe_failures": 3},
  "evidence": {"enabled": true, "seconds": 60, "after": 5,
               "max_packets": 20000, "max_mb": 200},
  "filewatch": {"scan_dirs": ["~/Downloads", "~/Desktop", "/tmp", "/var/tmp", "/dev/shm"],
                "max_scan_mb": 100, "quarantine": true, "scanner": "auto", "ignore": []},
  "host": {"interval": 15, "ignore_exes": []},
  "protect": {"enabled": true, "pin_gateway": true, "isolate": true,
              "isolate_minutes": 60, "isolate_max": 3, "never_isolate": [],
              "block_ips": true, "block_max": 20, "never_block": [],
              "cut_connections": true, "flush_dns": true,
              "repair_dhcp": true, "ipv6_lockdown": true, "llmnr_off": true,
              "block_redirects": true, "https_guard": true,
              "kill_switch": false, "block_wpad": true, "pin_devices": true,
              "pin_router6": true, "public_hardening": true},
  "wifi": {"monitor_interface": null, "ssids": ["YourWiFiName"], "trusted_bssids": [],
           "deauth_window": 10, "deauth_threshold": 20}
}
